# WhatsApp bridge config — copy to .env and fill in values.
# .env is gitignored. Never put a real value in THIS file: it is committed.

# Orchestrator URL (Tailscale IP or MagicDNS name of the orchestrator host)
ORCHESTRATOR_URL=http://YOUR_ORCHESTRATOR_TAILSCALE_IP:8000

# Same secret key used across all machines
INFRA_SECRET_KEY=your-secret-key-here

# Waha container (running locally on the Mac Mini via OrbStack)
WAHA_URL=http://localhost:3000

# WAHA credentials — consumed by docker-compose.yml as ${WAHA_*}.
# These guard a live WhatsApp session: anyone holding the API key can read and
# send messages as you, and the dashboard login is a second door to the same
# thing. Generate the key with `openssl rand -hex 16` and keep both in Bitwarden.
WAHA_API_KEY=generate-with-openssl-rand-hex-16
WAHA_DASHBOARD_USERNAME=your-dashboard-username
WAHA_DASHBOARD_PASSWORD=your-dashboard-password

# This machine's Tailscale IP or MagicDNS name, used to build artifact download
# links that must open on your phone. Leave empty and links fall back to
# localhost — the bridge still runs, but the links only work on this machine.
PUBLIC_HOST=

# Port the bridge listens on (Waha sends webhooks here)
BRIDGE_PORT=3001
