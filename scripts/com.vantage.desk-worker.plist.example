<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: vantage desk worker (scripts/desk_worker.py).

  This file holds NO secrets. DESK_SECRET must be supplied from the user's environment file or via
  `launchctl setenv DESK_SECRET ...`; it is never stored in this file or in the repo.
  Replace REPO_PATH with the absolute path of your checkout and ORCHESTRATOR_URL with your orchestrator's address.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.vantage.desk-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>python3</string>
    <string>REPO_PATH/scripts/desk_worker.py</string>
  </array>

  <key>WorkingDirectory</key><string>REPO_PATH</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ORCHESTRATOR_URL</key><string>http://100.64.0.1:8000</string>
    <key>DESK_REPO_ROOT</key><string>REPO_PATH</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>

  <key>StandardOutPath</key><string>/tmp/desk-worker.log</string>
  <key>StandardErrorPath</key><string>/tmp/desk-worker.log</string>
</dict>
</plist>
