<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: orchestrator (port 8000) on an always-on macOS machine, backed by the local rqlite node.

  This file holds NO secrets. SECRET_KEY, DEEPSEEK_API and the rest live in the repo's .env
  (chmod 600, gitignored); scripts/run-with-env.sh loads it, and anything set in
  EnvironmentVariables below wins over the file.

  Install (replace /Users/YOUR_USERNAME/Projects/distributed-infra with your checkout):
    mkdir -p logs && chmod 600 .env
    cp scripts/com.techstartups.orchestrator.plist.example ~/Library/LaunchAgents/com.techstartups.orchestrator.plist
    # edit the paths in the copy, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.techstartups.orchestrator.plist
  Restart after a code change:
    launchctl bootout gui/$(id -u)/com.techstartups.orchestrator; launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.techstartups.orchestrator.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.techstartups.orchestrator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/Projects/distributed-infra/scripts/run-with-env.sh</string>
    <string>--</string>
    <string>/Users/YOUR_USERNAME/Projects/distributed-infra/.venv/bin/uvicorn</string>
    <string>orchestrator.main:app</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>8000</string>
  </array>

  <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/Projects/distributed-infra</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USERNAME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MACHINE_NAME</key><string>mac-mini</string>
    <key>MACHINE_ROLE</key><string>orchestrator</string>
    <key>QUEUE_BACKEND</key><string>rqlite</string>
    <key>RQLITE_URL</key><string>http://localhost:4001</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/Projects/distributed-infra/logs/orchestrator.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/Projects/distributed-infra/logs/orchestrator.err</string>
</dict>
</plist>
