# Environment & secrets
.env
*.env
.env.*
!.env.example

# machines.yaml contains real Tailscale IPs — use machines.yaml.example as template
config/machines.yaml
!config/machines.yaml.example

# Data (SQLite queue lives here, not in git)
data/
*.db
*.db-journal

# Waha session credentials — persisted by the WhatsApp bridge container
services/whatsapp-bridge/waha-sessions/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/
*.log

# macOS
.DS_Store

# Installed launchd plists carry local paths (and, in older installs, secrets). Track only the .plist.example templates.
scripts/*.plist
!scripts/*.plist.example
services/whatsapp-bridge/*.plist
!services/whatsapp-bridge/*.plist.example

# Per-machine systemd units are generated from the *.service.example / *.service templates
*.service.local

# Editor
.vscode/
.idea/
*.swp

# location.yaml holds mutable last-known location (handler writes it) — use the .example
config/location.yaml
!config/location.yaml.example

# project registry holds local paths/state (handler writes it) — use the .example
config/projects.yaml
!config/projects.yaml.example

# family roster holds phone numbers (PII) — use family.json.example
config/family.json
!config/family.json.example

# local scratch & config backups
config/*.bak*
scratch/

# Claude Code / agent local settings: allowlists in here can capture secrets verbatim
.claude/settings.local.json
.claude/*.local.*

# Keys and certificates, whatever their name
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Backup files made by in-place edits
*.bak
*.bak.*
*.orig
