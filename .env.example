# ── Copy to .env and fill in real values:   cp .env.example .env && chmod 600 .env ──────────
# .env is gitignored. NEVER put a real value in THIS file: it is committed, and the repo is public.
# Every key can instead come from the process environment (a shell export, a launchd/systemd
# setting, or a CI secret); a variable already set in the environment wins over this file.
# scripts/run-with-env.sh loads this file for launchd; systemd uses EnvironmentFile=.
# Each machine gets its own .env. Copy it between machines over Tailscale (scripts/sync-env.sh)
# or keep the originals in a password manager (Bitwarden, 1Password, ...).

# ── Identity ───────────────────────────────────────────────────────────────────────────────
MACHINE_NAME=my-machine                    # a key in config/machines.yaml
MACHINE_ROLE=worker                        # orchestrator | worker

# ── Shared secret: the SAME value on every machine ─────────────────────────────────────────
# generate:  openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ── Where the orchestrators are (Tailscale IP or MagicDNS name, comma-separated) ───────────
# Workers and clients try them in order and fail over to the next on a connection error.
# Single machine / first try:  http://localhost:8000
ORCHESTRATOR_URLS=http://localhost:8000
TAILSCALE_IP=                               # this machine's `tailscale ip -4` (optional)

# ── Orchestrator only ──────────────────────────────────────────────────────────────────────
QUEUE_HOST=0.0.0.0                          # bind to your Tailscale IP to keep it off the LAN
QUEUE_PORT=8000
QUEUE_BACKEND=sqlite                        # sqlite = one machine, no setup | rqlite = the HA cluster
QUEUE_DB_PATH=./data/queue.db               # sqlite only
# RQLITE_URL=http://localhost:4001          # rqlite only: this machine's own rqlite node

# ── Worker only ────────────────────────────────────────────────────────────────────────────
WORKER_PORT=8001
POLL_INTERVAL_SECONDS=10
# Task types this machine may claim (comma-separated). Examples:
#   mac:    ios_build,xcode,flutter,agent_run,run_script,git_pull,test_run,lint
#   linux:  android_build,gradle,python_backend,node_backend,docker,agent_run,run_script,git_pull,test_run,lint
MACHINE_CAPABILITIES=git_pull,run_script

# ── Agents ─────────────────────────────────────────────────────────────────────────────────
# claude, codex and agy use their own CLI login on each worker (`claude login`, `codex login`): no key here.
# DeepSeek is an HTTP API:
DEEPSEEK_API=
# Optional: the AI assistant HTTP API
ASSISTANT_API_URL=
ASSISTANT_API_KEY=

# ── Monitoring (optional) ──────────────────────────────────────────────────────────────────
VANTAGE_URL=http://localhost:8055           # your Vantage monitor
VANTAGE_INGEST_KEY=
